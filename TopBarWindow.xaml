<Window x:Class="VampireKeyboard.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vampire Keyboard" Height="38" Width="196"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid>
        <Border x:Name="MainBar" Background="#2A1E3F" CornerRadius="19" BorderBrush="#C0392B"
                BorderThickness="1" Padding="4,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                        Background="#120C1C" Cursor="Hand"
                        MouseLeftButtonUp="Logo_Click">
                    <Image Source="Assets/dracula.png" Stretch="Uniform" Margin="2"/>
                </Border>
                <Border Grid.Column="1" Cursor="Hand" MouseLeftButtonUp="Lang_Click"
                        Background="Transparent">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Margin="8,0,4,0" FontSize="11" Foreground="#F3EAFB"/>
                </Border>
                <TextBlock Grid.Column="2" x:Name="OnOffText" VerticalAlignment="Center"
                           FontSize="9" Foreground="#8A78A3" Margin="0,0,8,0"/>
            </Grid>
        </Border>
        <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=MainBar}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#2A1E3F" CornerRadius="10" BorderBrush="#C0392B"
                    BorderThickness="1" Margin="0,4,0,0" Width="240">
                <StackPanel>
                    <TextBlock Text="From (you type)" FontSize="11" Foreground="#8A78A3"
                               Margin="12,10,0,4"/>
                    <ComboBox x:Name="FromBox" Margin="12,0,12,6" Height="30" FontSize="12"
                              Background="#120C1C" Foreground="#F3EAFB"
                              SelectionChanged="From_Changed"/>
                    <TextBlock Text="To (output)" FontSize="11" Foreground="#8A78A3"
                               Margin="12,2,0,4"/>
                    <ComboBox x:Name="ToBox" Margin="12,0,12,6" Height="30" FontSize="12"
                              Background="#120C1C" Foreground="#F3EAFB"
                              SelectionChanged="To_Changed"/>
                    <Separator Background="#3D2F55" Margin="8,6"/>
                    <Grid Margin="12,4,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="EnableBox" Content="Conversion ON"
                                  Foreground="#7DCEA0" FontSize="12" FontWeight="SemiBold"
                                  Checked="Enable_Changed" Unchecked="Enable_Changed"/>
                        <Button Grid.Column="1" Content="More..."
                                Background="#C0392B" Foreground="White" BorderThickness="0"
                                Padding="10,3" FontSize="12" Cursor="Hand"
                                Click="More_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

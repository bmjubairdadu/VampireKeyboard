<Window x:Class="VampireKeyboard.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vampire Keyboard" Height="56" Width="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid>
        <Border x:Name="MainBar" Background="#2A1E3F" CornerRadius="12" BorderBrush="#C0392B"
                BorderThickness="1" Padding="8,4" MouseLeftButtonDown="Bar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                        Background="#120C1C" Cursor="Hand"
                        MouseLeftButtonUp="Logo_Click">
                    <Image Source="Assets/dracula.png" Stretch="Uniform" Margin="3"/>
                </Border>
                <Border Grid.Column="1" Cursor="Hand" MouseLeftButtonUp="Lang_Click">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                               Margin="10,0,6,0" FontSize="12" Foreground="#F3EAFB"/>
                </Border>
                <TextBlock Grid.Column="2" x:Name="OnOffText" VerticalAlignment="Center"
                           FontSize="10" Foreground="#8A78A3" Margin="0,0,6,0"/>
            </Grid>
        </Border>
        <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=MainBar}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#2A1E3F" CornerRadius="10" BorderBrush="#C0392B"
                    BorderThickness="1" Margin="0,4,0,0" Width="280">
                <StackPanel>
                    <TextBlock Text="Language" FontSize="11" Foreground="#8A78A3"
                               Margin="12,10,0,4"/>
                    <ListBox x:Name="LangList" MaxHeight="260" BorderThickness="0"
                             Background="Transparent" Foreground="#F3EAFB"
                             SelectionChanged="LangList_SelectionChanged"/>
                    <Separator Background="#3D2F55" Margin="8,6"/>
                    <TextBlock Text="Typing Mode" FontSize="11" Foreground="#8A78A3"
                               Margin="12,2,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="12,0,12,4">
                        <RadioButton x:Name="ModeConvert" GroupName="mode" Content="Convert typing"
                                     Foreground="#F3EAFB" FontSize="12" Margin="0,0,14,0"
                                     Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeNormal" GroupName="mode" Content="Normal typing"
                                     Foreground="#F3EAFB" FontSize="12" Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeBijoy" GroupName="mode" Content="Bijoy"
                                     Foreground="#F3EAFB" FontSize="12" Checked="Mode_Changed"
                                     ToolTip="Bijoy/Avro keyboard style - for official work"/>
                    </StackPanel>
                    <Separator Background="#3D2F55" Margin="8,6"/>
                    <Grid Margin="12,4,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="EnableBox" Content="Keyboard conversion ON"
                                  Foreground="#7DCEA0" FontSize="12" FontWeight="SemiBold"
                                  Checked="Enable_Changed" Unchecked="Enable_Changed"/>
                        <Button Grid.Column="1" Content="More..."
                                Background="#C0392B" Foreground="White" BorderThickness="0"
                                Padding="10,3" FontSize="12" Cursor="Hand"
                                Click="More_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

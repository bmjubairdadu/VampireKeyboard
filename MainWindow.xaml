<Window x:Class="VampireKeyboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vampire Keyboard — Setup"
        Height="560" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1B1225"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#2A1E3F"/>
        <SolidColorBrush x:Key="Accent" Color="#C0392B"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3EAFB"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Border Width="86" Height="86" CornerRadius="20" Background="#120C1C"
                    BorderBrush="#C0392B" BorderThickness="2">
                <Image Source="Assets/dracula.png" Stretch="Uniform" Margin="8"/>
            </Border>
            <TextBlock Text="Vampire Keyboard" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Type Banglish, get বাংলা — anywhere in Windows"
                       FontSize="13" Foreground="#B8A8CC" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="WelcomePanel" Visibility="Visible">
            <Border Background="{StaticResource CardBg}" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock Text="Welcome to the installation wizard 🧛"
                               FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock FontSize="14" Foreground="#CBBFE0" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Vampire Keyboard lets every country's users type in their own language — with special focus on Bangladesh.&#x0A;&#x0A;• Bangladeshi developers can type Banglish (e.g. 'ami tumake bhalobashi') and it instantly becomes বাংলা in any app.&#x0A;• Or translate directly between Bangla and English.&#x0A;• Your chosen language is saved permanently until you change it.&#x0A;• Runs quietly in the system tray next to the clock."/>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="LanguagePanel" Visibility="Collapsed">
            <TextBlock Text="Choose your language" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMain}" Margin="4,0,0,10"/>
            <ListBox x:Name="LanguageList" Height="300"
                     SelectionChanged="LanguageList_SelectionChanged"
                     Background="{StaticResource CardBg}" Foreground="{StaticResource TextMain}"
                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <CheckBox x:Name="EnableAutoStartBox" IsChecked="True" Margin="4,12,0,0"
                      Foreground="{StaticResource TextMain}" FontSize="13"
                      Content="Start Vampire Keyboard automatically when Windows starts"/>
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="DonePanel" Visibility="Collapsed">
            <Border Background="{StaticResource CardBg}" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock Text="✅ Installation complete!" FontSize="20" FontWeight="Bold"
                               Foreground="#7DCEA0"/>
                    <TextBlock FontSize="14" Foreground="#CBBFE0" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Vampire Keyboard is now running in your system tray.&#x0A;&#x0A;You'll see a small Vampire icon near the clock — click it anytime to change language or settings.&#x0A;&#x0A;Now just type Banglish in any app: your word will instantly become বাংলা!"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="StartBtn" Content="🧛 Start Vampire Keyboard"
                    Visibility="Collapsed" HorizontalAlignment="Left"
                    Click="StartBtn_Click" Background="#7DCEA0" Foreground="#1B1225" FontWeight="Bold"/>
            <Button Grid.Column="1" x:Name="BackBtn" Content="← Back" Visibility="Collapsed"
                    Margin="0,0,10,0" Background="#3D2F55" Click="BackBtn_Click"/>
            <Button Grid.Column="2" x:Name="NextBtn" Content="Next →" FontWeight="Bold"
                    Click="NextBtn_Click"/>
        </Grid>
    </Grid>
</Window>

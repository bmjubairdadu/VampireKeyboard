<Window x:Class="VampireKeyboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vampire Keyboard - Setup"
        Height="520" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1B1225"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#2A1E3F"/>
        <SolidColorBrush x:Key="Accent" Color="#C0392B"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3EAFB"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Border Width="72" Height="72" CornerRadius="16" Background="#120C1C"
                    BorderBrush="#C0392B" BorderThickness="2">
                <Image Source="Assets/dracula.png" Stretch="Uniform" Margin="6"/>
            </Border>
            <TextBlock Text="Vampire Keyboard" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Type Banglish, get Bangla - anywhere in Windows"
                       FontSize="13" Foreground="#B8A8CC" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" x:Name="WelcomePanel" Visibility="Visible">
            <Border Background="{StaticResource CardBg}" CornerRadius="14" Padding="24">
                <StackPanel>
                    <TextBlock Text="How to use"
                               FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock FontSize="14" Foreground="#CBBFE0" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="1. Click OK below - a small bar appears at the top-right of your screen.&#x0A;&#x0A;2. Click the bar to open the menu - there you can change the language anytime.&#x0A;&#x0A;3. Type Banglish in any app (Notepad, Word, Chrome, Office...) -&#x0A;    after each word press Space and it instantly becomes Bangla.&#x0A;&#x0A;    Example: 'ami bhalo achi' + Space = Bangla text&#x0A;&#x0A;4. Language choice is saved permanently until you change it."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" x:Name="EnableAutoStartBox" IsChecked="True"
                      Foreground="#CBBFE0" FontSize="13" VerticalAlignment="Center"
                      Content="Start automatically when Windows starts"/>
            <Button Grid.Column="1" x:Name="OkBtn" Content="OK" FontWeight="Bold"
                    HorizontalAlignment="Right" Click="OkBtn_Click" MinWidth="120"/>
        </Grid>
    </Grid>
</Window>

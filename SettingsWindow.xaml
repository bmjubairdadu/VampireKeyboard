<Window x:Class="VampireKeyboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vampire Keyboard â€” Settings" Height="600" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1B1225">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#2A1E3F"/>
        <SolidColorBrush x:Key="Accent" Color="#C0392B"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3EAFB"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="46" Height="46" CornerRadius="10" Background="#120C1C"
                    BorderBrush="#C0392B" BorderThickness="1">
                <Image Source="Assets/dracula.png" Stretch="Uniform" Margin="5"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Vampire Keyboard" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="Customize your language &amp; translation" FontSize="12" Foreground="#B8A8CC"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Your language (saved until you change it)" FontSize="13"
                       Foreground="#CBBFE0" Margin="2,0,0,6"/>
            <ComboBox x:Name="LanguageBox" Height="38" FontSize="14"
                      Background="{StaticResource CardBg}" Foreground="{StaticResource TextMain}"
                      SelectionChanged="LanguageBox_SelectionChanged"/>
        </StackPanel>
        <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="12" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Direct translator (Bangla â‡„ English, or any language)"
                           FontSize="13" Foreground="#CBBFE0" Margin="0,0,0,8"/>

                <TextBox Grid.Row="1" x:Name="SourceBox" AcceptsReturn="True" TextWrapping="Wrap"
                         FontSize="14" Background="#120C1C" Foreground="{StaticResource TextMain}"
                         BorderBrush="#3D2F55" Padding="8"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
                    <ComboBox x:Name="FromBox" Width="110" Height="30" FontSize="12"/>
                    <TextBlock Text=" â†’ " Foreground="#CBBFE0" FontSize="14" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ToBox" Width="110" Height="30" FontSize="12"/>
                    <Button Content="Translate" Margin="12,0,0,0" Click="TranslateBtn_Click" Padding="14,5"/>
                    <Button Content="Copy" Margin="8,0,0,0" Click="CopyBtn_Click" Background="#3D2F55" Padding="14,5"/>
                </StackPanel>

                <TextBox Grid.Row="3" x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap"
                         FontSize="14" Background="#120C1C" Foreground="#7DCEA0"
                         BorderBrush="#3D2F55" Padding="8"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="EnableHookBox" Grid.Column="0" VerticalAlignment="Center"
                      Foreground="{StaticResource TextMain}" FontSize="13"
                      Content="Banglish â†’ à¦¬à¦¾à¦‚à¦²à¦¾ live conversion is ON"
                      Checked="EnableHook_Changed" Unchecked="EnableHook_Changed"/>
            <Button Grid.Column="1" Content="Close" Background="#3D2F55" Click="CloseBtn_Click"/>
        </Grid>
    </Grid>
</Window>
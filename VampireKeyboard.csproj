<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\dracula.ico</ApplicationIcon>
    <AssemblyName>VampireKeyboard</AssemblyName>
    <RootNamespace>VampireKeyboard</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Vampire Keyboard</Product>
    <CompanyName>Vampire Keyboard Team</CompanyName>
    <Description>Type Banglish, get Bangla — anywhere in Windows. Multilingual keyboard for everyone.</Description>
    <Copyright>© 2026 Vampire Keyboard Team</Copyright>
    <FileVersion>1.0.0</FileVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\dracula.png" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Windows" />
  </ItemGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!--
    The default glob only excludes THIS project's obj/bin. Nested scratch
    projects (e.g. a stray TestTool\obj) would otherwise be compiled into this
    assembly and break it with duplicate AssemblyInfo attributes.
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\obj\**;**\bin\**;TestTool\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
